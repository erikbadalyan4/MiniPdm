<Window x:Class="MiniPdm.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MiniPdm.UI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="Мини-PDM: Состав изделия (АСКОН)" Height="750" Width="1150"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель действий -->
        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Поиск:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                         Height="28" VerticalContentAlignment="Center" Padding="5,0"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Импорт папки CAD..." Command="{Binding ImportFolderCommand}" 
                            Height="30" Padding="12,0" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <Button Content="Сводная спецификация..." Command="{Binding OpenSpecificationCommand}" 
                            Height="30" Padding="12,0" Margin="0,0,8,0"/>
                    <Button Content="Сравнение версий..." Command="{Binding OpenDiffCommand}" 
                            Height="30" Padding="12,0" Margin="0,0,8,0"/>
                    <Button Content="Обновить" Command="{Binding RefreshCommand}" 
                            Height="30" Padding="12,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основная рабочая область -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="250"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель: Дерево состава -->
            <Border Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F1F5F9" Padding="10,8" CornerRadius="4,4,0,0">
                        <TextBlock Text="Дерево состава изделия" FontWeight="SemiBold" Foreground="#334155"/>
                    </Border>

                    <TreeView Grid.Row="1" ItemsSource="{Binding RootItems}" BorderThickness="0" Margin="4">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <TextBlock Text="{Binding DisplayText}" FontWeight="Normal"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <!-- Сплиттер -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Правая панель: Свойства объекта и состав 1-го уровня -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Карточка объекта -->
                <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" 
                        Background="White" Margin="0,0,0,10" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Карточка выбранного объекта" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Обозначение:" Foreground="#64748B"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Details.Designation}" FontWeight="SemiBold"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Версия:" Foreground="#64748B"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Details.VersionNumber}" FontWeight="SemiBold"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Наименование:" Foreground="#64748B"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Details.Name}" FontWeight="SemiBold"/>

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Состояние:" Foreground="#64748B"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Details.StateName}" FontWeight="SemiBold" Foreground="#2563EB"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Тип объекта:" Foreground="#64748B"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Details.TypeName}"/>

                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Масса 1 шт:" Foreground="#64748B"/>
                            <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Details.MassKg}"/>
                        </Grid>

                        <!-- Панель кнопок смены состояний -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Утвердить" Command="{Binding Details.ApproveCommand}" 
                                    Height="28" Padding="12,0" Margin="0,0,8,0" Background="#DCFCE7" BorderBrush="#86EFAC"/>
                            <Button Content="Аннулировать" Command="{Binding Details.ObsoleteCommand}" 
                                    Height="28" Padding="12,0" Margin="0,0,8,0" Background="#FEE2E2" BorderBrush="#FCA5A5"/>
                            <Button Content="Создать новую версию" Command="{Binding Details.CreateNewVersionCommand}" 
                                    Height="28" Padding="12,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Состав 1-го уровня -->
                <Border Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Background="White">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#F1F5F9" Padding="10,8" CornerRadius="4,4,0,0">
                            <TextBlock Text="Состав первого уровня (непосредственные вхождения)" FontWeight="SemiBold" Foreground="#334155"/>
                        </Border>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding FirstLevelComponents}" AutoGenerateColumns="False" 
                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  AlternatingRowBackground="#FAFAFA" BorderThickness="0" RowHeight="28">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="120"/>
                                <DataGridTextColumn Header="Обозначение" Binding="{Binding Designation.Value}" Width="150"/>
                                <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="90"/>
                                <DataGridTextColumn Header="Масса 1 шт (кг)" Binding="{Binding MassKg, StringFormat='{}{0:F3}'}" Width="110"/>
                                <DataGridTextColumn Header="Материал" Binding="{Binding Material}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Нижняя строка состояния -->
        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding ImportStatusText}" VerticalAlignment="Center" Foreground="#475569"/>

                <ProgressBar Grid.Column="1" Value="{Binding ImportProgress, Mode=OneWay}" Maximum="100" Height="14" Margin="10,0"
                             Visibility="{Binding IsImporting, Converter={StaticResource BoolToVis}}"/>

                <Button Grid.Column="2" Content="Отмена" Command="{Binding CancelImportCommand}" Height="24" Padding="10,0"
                        Visibility="{Binding IsImporting, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
