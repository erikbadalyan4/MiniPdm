<Window x:Class="MiniPdm.UI.Views.ConsolidatedSpecificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MiniPdm.UI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:ConsolidatedSpecificationViewModel}"
        Title="Сводная спецификация и расчет массы" Height="550" Width="850"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и статус -->
        <Border Grid.Row="0" Background="#F8FAFC" Padding="12" CornerRadius="4" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="{Binding AssemblyTitle, StringFormat='Сборка: {0}'}" FontWeight="Bold" FontSize="15" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding StatusMessage}" FontSize="13">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#1E293B"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMissingMass}" Value="True">
                                    <Setter Property="Foreground" Value="#DC2626"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Таблица спецификации -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" AutoGenerateColumns="False" 
                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#FAFAFA" BorderBrush="#E2E8F0" RowHeight="28">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="120"/>
                <DataGridTextColumn Header="Обозначение" Binding="{Binding Designation.Value}" Width="150"/>
                <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Материал" Binding="{Binding Material}" Width="120"/>
                <DataGridTextColumn Header="Количество" Binding="{Binding TotalQuantity}" Width="90"/>
                <DataGridTextColumn Header="Масса 1 шт (кг)" Binding="{Binding UnitMassKg, StringFormat='{}{0:F3}'}" Width="110"/>
                <DataGridTextColumn Header="Общая масса (кг)" Binding="{Binding TotalMassKg, StringFormat='{}{0:F3}'}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Панель кнопок -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Экспорт в CSV..." Command="{Binding ExportCommand}" Width="140" Height="30" Margin="0,0,10,0"/>
            <Button Content="Закрыть" Width="100" Height="30" IsCancel="True" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
