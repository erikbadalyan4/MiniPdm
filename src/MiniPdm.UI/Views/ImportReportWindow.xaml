<Window x:Class="MiniPdm.UI.Views.ImportReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MiniPdm.UI.ViewModels"
        xmlns:common="clr-namespace:MiniPdm.UI.Common"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:ImportReportViewModel}"
        Title="Отчёт об импорте" Height="500" Width="820"
        WindowStartupLocation="CenterOwner" Background="White" FontFamily="Segoe UI"
        common:WindowHelper.RemoveIcon="True">
    
    <Window.Resources>
        <!-- Стилизация кнопок со скруглением -->
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стилизация заголовка таблицы -->
        <Style x:Key="TableHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стилизация строк таблицы -->
        <Style x:Key="TableRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стилизация ячеек таблицы -->
        <Style x:Key="TableCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" BorderThickness="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя шапка окна -->
        <Border Grid.Row="0" Background="White" Height="46" Padding="20,0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <TextBlock Text="Отчёт об импорте" FontWeight="Bold" FontSize="16" Foreground="#0F172A" VerticalAlignment="Center"/>
        </Border>

        <!-- Основная область окна -->
        <Grid Grid.Row="1" Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Путь к папке -->
            <TextBlock Grid.Row="0" Text="{Binding FolderPathText}" Foreground="#64748B" FontSize="12.5" Margin="0,0,0,12"/>

            <!-- Статистические плашки / пилюли -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
                <!-- Принято -->
                <Border Background="#DCFCE7" CornerRadius="12" Padding="14,4" Margin="0,0,10,0">
                    <TextBlock Text="{Binding AcceptedBadgeText}" Foreground="#15803D" FontWeight="SemiBold" FontSize="12.5"/>
                </Border>

                <!-- Ошибок -->
                <Border Background="#FEE2E2" CornerRadius="12" Padding="14,4" Margin="0,0,10,0">
                    <TextBlock Text="{Binding ErrorsBadgeText}" Foreground="#B91C1C" FontWeight="SemiBold" FontSize="12.5"/>
                </Border>

                <!-- Предупреждений -->
                <Border Background="#FEF9C3" CornerRadius="12" Padding="14,4">
                    <TextBlock Text="{Binding WarningsBadgeText}" Foreground="#A16207" FontWeight="SemiBold" FontSize="12.5"/>
                </Border>
            </StackPanel>

            <!-- Таблица результатов -->
            <DataGrid Grid.Row="2" ItemsSource="{Binding DisplayItems}" AutoGenerateColumns="False"
                      IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F1F5F9" BorderThickness="0" Background="Transparent"
                      ColumnHeaderStyle="{StaticResource TableHeaderStyle}"
                      RowStyle="{StaticResource TableRowStyle}"
                      CellStyle="{StaticResource TableCellStyle}"
                      CanUserResizeRows="False" SelectionMode="Single">
                <DataGrid.Columns>
                    <!-- Файл -->
                    <DataGridTemplateColumn Header="Файл" Width="240">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusIcon}" Foreground="{Binding StatusIconColor}"
                                               FontWeight="Bold" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding FileName}" Foreground="#0F172A" FontSize="12.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Результат -->
                    <DataGridTemplateColumn Header="Результат" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SeverityText}" Foreground="{Binding SeverityColor}"
                                           FontSize="12.5" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Причина -->
                    <DataGridTemplateColumn Header="Причина" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Reason}" Foreground="#334155" FontSize="12.5"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Нижняя панель действий -->
            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Фильтр -->
                <ComboBox Grid.Column="0" ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding SelectedFilter}"
                          Style="{StaticResource ModernComboBoxStyle}"
                          Width="180" Height="32"/>

                <!-- Кнопки справа -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Сохранить в файл..." Command="{Binding SaveReportCommand}"
                            Style="{StaticResource RoundedButtonStyle}"
                            Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#334155"
                            Height="32" Padding="14,0" Margin="0,0,10,0" FontSize="12.5"/>

                    <Button Content="Закрыть" Style="{StaticResource RoundedButtonStyle}"
                            Background="#2563EB" Foreground="White" FontWeight="SemiBold"
                            Height="32" Padding="20,0" FontSize="12.5" IsCancel="True" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>

